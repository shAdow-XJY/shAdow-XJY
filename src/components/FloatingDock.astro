---
/**
 * FloatingDock.astro
 * 底部浮动 Dock 导航 — 毛玻璃背景 + hover 发光效果
 */
interface NavLink {
  icon: string; // SVG path data or emoji fallback
  label: string;
  href: string;
}

interface Props {
  links?: NavLink[];
}

const {
  links = [
    { icon: 'github', label: 'GitHub', href: 'https://github.com/shAdow-XJY' },
    { icon: 'shadowplusing', label: 'ShadowPlusing', href: 'https://shadowplusing.us' },
    { icon: 'website', label: 'Website', href: 'https://shadowplusing.website' },
  ]
} = Astro.props;

// SVG icons as inline paths
const ICONS: Record<string, string> = {
  github: `<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>`,
  shadowplusing: `<circle cx="12" cy="12" r="10"/><path stroke="currentColor" stroke-width="2" d="M8 12h8M12 8v8"/>`,
  website: `<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a10 10 0 100 20A10 10 0 0012 2zm0 0v10m0-18L6 8m6 6l6-6m-6 6l-6-6"/>`,
};
---

<nav
  id="floating-dock"
  style="
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: 1rem;
    background: rgba(22,27,34,0.92);
    border: 1px solid #30363d;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 0 0 1px rgba(88,166,255,0.08), 0 20px 60px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.04);
  "
>
  {links.map(({ icon, label, href }) => (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={label}
      class="dock-item"
      data-icon={icon}
      style="
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        padding: 0.5rem 1.25rem;
        border-radius: 0.75rem;
        transition: background 200ms ease;
        text-decoration: none;
      "
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        style="color: #8b949e; transition: color 200ms ease;"
      >
        <Fragment set:html={ICONS[icon] ?? ICONS.website} />
      </svg>
      <span
        style="
          font-family: 'JetBrains Mono', monospace;
          font-size: 10px;
          color: #8b949e;
          letter-spacing: 0.03em;
          transition: color 200ms ease;
        "
      >
        {label}
      </span>
    </a>
  ))}
</nav>

<style>
  .dock-item:hover {
    background: rgba(88, 166, 255, 0.08) !important;
  }
  .dock-item:hover svg {
    color: #58a6ff !important;
  }
  .dock-item:hover span {
    color: #e6edf3 !important;
  }
</style>
