---
/**
 * FloatingDock.astro
 * 底部浮动 Dock 导航 — 毛玻璃背景 + hover 发光效果
 */

interface NavLink {
  icon: 'github' | 'website' | 'blog';
  label: string;
  href: string;
}

export interface Props {
  sets: NavLink[][];
}

const { sets } = Astro.props;

// Uniform feather-like SVG icons
const ICONS: Record<string, string> = {
  github: `<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>`,
  website: `<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/><path stroke="currentColor" stroke-width="2" d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>`,
  blog: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" stroke="currentColor" stroke-width="2" fill="none"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" stroke="currentColor" stroke-width="2" fill="none"/>`,
};
---

<nav
  style="
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.75rem;
    border-radius: 1rem;
    background: rgba(22,27,34,0.92);
    border: 1px solid #30363d;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 0 0 1px rgba(88,166,255,0.08), 0 20px 60px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.04);
  "
>
  {sets.map((links, index) => (
    <div class="dock-set" data-index={index} style={`display: ${index === 0 ? 'flex' : 'none'}; align-items: center; gap: 0.25rem;`}>
      {links.map(({ icon, label, href }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={label}
          class="dock-item"
          style="
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.25rem;
            padding: 0.5rem 1.25rem;
            border-radius: 0.75rem;
            transition: background 200ms ease;
            text-decoration: none;
          "
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            style="color: #8b949e; transition: color 200ms ease;"
          >
            <Fragment set:html={ICONS[icon] ?? ICONS.website} />
          </svg>
          <span
            style="
              font-family: 'JetBrains Mono', monospace;
              font-size: 10px;
              color: #8b949e;
              letter-spacing: 0.03em;
              transition: color 200ms ease;
            "
          >
            {label}
          </span>
        </a>
      ))}
    </div>
  ))}
</nav>

<style>
  .dock-item:hover {
    background: rgba(88, 166, 255, 0.08) !important;
  }
  .dock-item:hover svg {
    color: #58a6ff !important;
  }
  .dock-item:hover span {
    color: #e6edf3 !important;
  }
</style>
