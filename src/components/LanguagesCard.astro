---
/**
 * LanguagesCard.astro
 * Top Languages 卡片 — SVG 内联，静态渲染
 */
interface LangItem {
  name: string;
  pct: number;
}

interface Props {
  languages?: LangItem[];
}

const LANG_COLORS: Record<string, string> = {
  Dart:       '#00B4AB',
  'C++':      '#f34b7d',
  TypeScript: '#3178c6',
  CSS:        '#563d7c',
  Java:       '#b07219',
  C:          '#555555',
  Vue:        '#41b883',
  JavaScript: '#f7df1e',
  Python:     '#3572A5',
  Swift:      '#F05138',
  Kotlin:     '#A97BFF',
  Rust:       '#dea584',
  Go:         '#00ADD8',
  Ruby:       '#701516',
  PHP:        '#4F5D95',
  HTML:       '#e34c26',
  Shell:      '#89e051',
  Svelte:     '#ff3e00',
  Lua:        '#000080',
};

const {
  languages = [
    { name: 'Dart',       pct: 50.0 },
    { name: 'C++',        pct: 14.3 },
    { name: 'TypeScript',  pct: 7.1  },
    { name: 'CSS',        pct: 7.1  },
    { name: 'Java',       pct: 7.1  },
    { name: 'C',          pct: 7.1  },
    { name: 'Vue',        pct: 7.1  },
  ]
} = Astro.props;

const W = 500;
const BAR_Y = 62;
const BAR_H = 10;
const INNER_W = W - 40;
const LIST_START = 100;
const ROW_H = 28;
const LANG_BAR_X = 170;
const LANG_BAR_W = INNER_W - 150;
const H = LIST_START + languages.length * ROW_H + 20;

// Stacked bar
let curX = 20;
const segments = languages.map(({ name, pct }) => {
  const segW = (pct / 100) * INNER_W;
  const seg = { name, pct, x: curX, w: segW, color: LANG_COLORS[name] ?? '#8b949e' };
  curX += segW;
  return seg;
});
---

<svg viewBox={`0 0 ${W} ${H}`} width="100%" xmlns="http://www.w3.org/2000/svg" style="display:block;">
  <defs>
    <linearGradient id="lg-bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1c2128" />
      <stop offset="100%" stop-color="#161b22" />
    </linearGradient>
    <linearGradient id="lg-accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#3fb950" />
      <stop offset="60%" stop-color="#58a6ff" />
      <stop offset="100%" stop-color="#58a6ff" stop-opacity="0" />
    </linearGradient>
    <clipPath id="stacked-bar-clip">
      <rect x="20" y={BAR_Y} width={INNER_W} height={BAR_H} rx="5" />
    </clipPath>
    <filter id="lg-glow">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>

  <!-- Card background -->
  <rect width={W} height={H} rx="12" fill="url(#lg-bg)" stroke="#30363d" stroke-width="1" />

  <!-- Top accent line -->
  <rect width={W * 0.58} height="2" rx="1" fill="url(#lg-accent)" filter="url(#lg-glow)" />

  <!-- Header -->
  <text x="20" y="34" font-family="'JetBrains Mono', monospace" font-size="13" fill="#3fb950" font-weight="600">Top Languages</text>
  <text x={W - 18} y="34" font-family="'JetBrains Mono', monospace" font-size="11" fill="#8b949e" text-anchor="end">by repo</text>

  <!-- Header divider -->
  <line x1="16" y1="46" x2={W - 16} y2="46" stroke="#21262d" stroke-width="1" />

  <!-- Stacked bar track -->
  <rect x="20" y={BAR_Y} width={INNER_W} height={BAR_H} rx="5" fill="#21262d" />

  <!-- Stacked segments -->
  {segments.map(({ name, x, w, color }) => (
    <rect key={name} x={x} y={BAR_Y} width={w} height={BAR_H} fill={color} clip-path="url(#stacked-bar-clip)" />
  ))}

  <!-- Divider below stacked bar -->
  <line x1="16" y1="86" x2={W - 16} y2="86" stroke="#21262d" stroke-width="1" />

  <!-- Language rows -->
  {languages.map(({ name, pct }, i) => {
    const y = LIST_START + i * ROW_H;
    const barW = (pct / 100) * LANG_BAR_W;
    const color = LANG_COLORS[name] ?? '#8b949e';
    const isLast = i === languages.length - 1;

    return (
      <g>
        <!-- Dot -->
        <circle cx="28" cy={y + 5} r="4" fill={color} />

        <!-- Name -->
        <text x="42" y={y + 10} font-family="'JetBrains Mono', monospace" font-size="12" fill="#e6edf3">{name}</text>

        <!-- Bar track -->
        <rect x={LANG_BAR_X} y={y + 1} width={LANG_BAR_W} height="8" rx="4" fill="#21262d" />

        <!-- Bar fill -->
        <rect x={LANG_BAR_X} y={y + 1} width={barW} height="8" rx="4" fill={color} opacity="0.9" />

        <!-- Percentage -->
        <text x={W - 18} y={y + 10} font-family="'JetBrains Mono', monospace" font-size="11" fill="#8b949e" text-anchor="end">{pct.toFixed(1)}%</text>

        <!-- Row separator -->
        {!isLast && (
          <line x1="16" y1={y + ROW_H - 2} x2={W - 16} y2={y + ROW_H - 2} stroke="#21262d" stroke-width="1" />
        )}
      </g>
    );
  })}
</svg>
