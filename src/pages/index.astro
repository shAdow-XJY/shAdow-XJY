---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsCard from '../components/StatsCard.astro';
import StreakCard from '../components/StreakCard.astro';
import LanguagesCard from '../components/LanguagesCard.astro';
import FloatingDock from '../components/FloatingDock.astro';

// GitHub 数据由预生成脚本提供（硬编码到构建时）
// GitHub Actions 运行 generate-svgs.ts 时同步更新此文件
const githubData = {
  repos: 16,
  followers: 5,
  following: 3,
  stars: 24,
  commits: 387,
  languages: [
    { name: 'Dart',       pct: 50.0 },
    { name: 'C++',        pct: 14.3 },
    { name: 'TypeScript',  pct: 7.1  },
    { name: 'CSS',        pct: 7.1  },
    { name: 'Java',       pct: 7.1  },
    { name: 'C',          pct: 7.1  },
    { name: 'Vue',        pct: 7.1  },
  ],
};
---

<BaseLayout title="shAdow-XJY — Shadow Space" description="shAdow-XJY 的个人主页">
  <!-- Subtle grid background -->
  <div
    aria-hidden="true"
    style="
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(48,54,61,0.25) 1px, transparent 1px),
        linear-gradient(90deg, rgba(48,54,61,0.25) 1px, transparent 1px);
      background-size: 48px 48px;
    "
  ></div>

  <!-- Glow blob top -->
  <div
    aria-hidden="true"
    style="
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      pointer-events: none;
      width: 600px;
      height: 300px;
      background: radial-gradient(ellipse at center, rgba(88,166,255,0.06) 0%, transparent 70%);
    "
  ></div>

  <main
    style="
      position: relative;
      z-index: 10;
      max-width: 36rem;
      margin: 0 auto;
      padding: 5rem 1rem 12rem;
    "
  >
    <!-- Profile Header -->
    <header class="text-center mb-14">
      <!-- Avatar with glowing ring -->
      <div class="relative mb-6">
        <!-- Glow behind avatar -->
        <div
          aria-hidden="true"
          style="
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(63,185,80,0.3) 0%, rgba(88,166,255,0.15) 50%, transparent 70%);
            transform: scale(1.4);
            filter: blur(12px);
          "
        ></div>
        <!-- Gradient ring -->
        <div
          style="
            position: relative;
            border-radius: 50%;
            padding: 3px;
            background: linear-gradient(135deg, #58a6ff 0%, #3fb950 50%, #58a6ff 100%);
            display: inline-block;
          "
        >
          <img
            src="https://github.com/shAdow-XJY.png"
            alt="shAdow-XJY avatar"
            width="96"
            height="96"
            loading="eager"
            style="
              display: block;
              width: 96px;
              height: 96px;
              border-radius: 50%;
              background: #161b22;
              object-fit: cover;
            "
          />
        </div>
      </div>

      <!-- Name -->
      <h1
        style="
          font-size: 2.25rem;
          font-weight: 700;
          letter-spacing: -0.025em;
          color: #e6edf3;
          font-family: 'Outfit', sans-serif;
          margin: 0 0 0.5rem;
        "
      >
        shAdow-XJY
      </h1>

      <!-- Handle -->
      <p
        style="
          font-family: 'JetBrains Mono', monospace;
          font-size: 0.875rem;
          color: #58a6ff;
          letter-spacing: 0.05em;
          margin: 0 0 1rem;
        "
      >
        @shAdow-XJY
      </p>

      <!-- Bio -->
      <p
        style="
          font-size: 1rem;
          max-width: 20rem;
          line-height: 1.625;
          color: #8b949e;
          margin: 0 auto;
        "
      >
        Developer · Creator · Founder of
        <span style="color: #3fb950; font-weight: 600;">ShadowPlusing</span>
      </p>

      <!-- Meta -->
      <div
        style="
          display: flex;
          align-items: center;
          gap: 1.25rem;
          margin-top: 1.25rem;
          flex-wrap: wrap;
          justify-content: center;
        "
      >
        <span
          style="
            display: flex;
            align-items: center;
            gap: 0.375rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: #8b949e;
          "
        >
          <!-- Map pin icon -->
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="#58a6ff"/>
          </svg>
          Earth
        </span>
        <span
          style="
            display: flex;
            align-items: center;
            gap: 0.375rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            color: #8b949e;
          "
        >
          <!-- Link icon -->
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" stroke="#3fb950" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          shadowplusing.dev
        </span>
      </div>
    </header>

    <!-- SVG Cards -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <!-- Section label: GitHub Stats -->
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem;">
        <span
          style="
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #8b949e;
          "
        >Github Stats</span>
        <div style="flex: 1; height: 1px; background: #21262d;"></div>
      </div>

      <!-- Stats card -->
      <div style="border-radius: 0.75rem; overflow: hidden; box-shadow: 0 0 0 1px #30363d, 0 8px 32px rgba(0,0,0,0.4);">
        <StatsCard
          repos={githubData.repos}
          followers={githubData.followers}
          following={githubData.following}
          stars={githubData.stars}
          commits={githubData.commits}
        />
      </div>

      <!-- Streak card -->
      <div style="border-radius: 0.75rem; overflow: hidden; box-shadow: 0 0 0 1px #30363d, 0 8px 32px rgba(0,0,0,0.4);">
        <StreakCard
          totalContributions={githubData.commits}
          currentStreak={12}
          longestStreak={21}
        />
      </div>

      <!-- Section label: Used Languages -->
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 1.5rem; margin-bottom: 0.25rem;">
        <span
          style="
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #8b949e;
          "
        >Used Languages</span>
        <div style="flex: 1; height: 1px; background: #21262d;"></div>
      </div>

      <!-- Languages card -->
      <div style="border-radius: 0.75rem; overflow: hidden; box-shadow: 0 0 0 1px #30363d, 0 8px 32px rgba(0,0,0,0.4);">
        <LanguagesCard languages={githubData.languages} />
      </div>
    </div>
  </main>

  <!-- Floating Dock -->
  <FloatingDock />
</BaseLayout>
