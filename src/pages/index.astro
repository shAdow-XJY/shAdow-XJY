  ],
  [ // shAdow-XJY-Website
    { icon: 'blog', label: 'Blog', href: 'https://shadow-xjy-website.github.io/' },
    { icon: 'website', label: 'Website', href: 'https://shadowplusing.us/' },
    { icon: 'github', label: 'GitHub', href: 'https://github.com/shAdow-XJY-Website' }
  ]
];

const githubData = [
  {
    handle: "shAdow-XJY",
    type: "personal",
    accent: "#58a6ff",
    accentB: "#3fb950",
    stats: {
