---
/**
 * BaseLayout — 新的 Figma 设计稿主题
 * 包含：Google Fonts、GitHub dark theme CSS、自定义 scrollbar
 */
import '../styles/global.css';

const {
  title = 'shAdow-XJY — Shadow Space',
  description = 'shAdow-XJY 的个人主页 — 开发者、创作者、ShadowPlusing 创始人',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <title>{title}</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} />
  </head>
  <body>
    <slot />
  </body>
</html>
